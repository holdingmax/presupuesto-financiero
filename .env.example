# Cadena de conexión de Neon (Postgres serverless).
# Se obtiene desde el dashboard de Neon > Connection Details.
DATABASE_URL="postgresql://usuario:password@ep-xxxxx.neon.tech/presupuesto_financiero?sslmode=require"

# Clave de firma de las cookies de sesión (jose). Generar con: openssl rand -base64 32
# No reutilizar la misma clave entre ambientes (prod/testing/local).
SESSION_SECRET="reemplazar-por-un-secreto-real"

# Contraseña inicial del admin (Leticia), usada solo por prisma/seed.ts — no la lee
# nada en runtime. Solo hace falta si vas a correr `npm run db:seed` en este ambiente.
SEED_ADMIN_PASSWORD="reemplazar-por-una-contraseña-inicial"
